{
  "manifest_version": 3,
  "name": "tabmaxxing",
  "version": "1.12.1",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube-nocookie.com;"
  },
  "description": "New Tab with a notepad and calendar",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background-service.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "youtube-quality.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "tabmaxxing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
